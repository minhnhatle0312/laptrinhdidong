# Cấu hình ứng dụng (Garage Management App)
# Sao chép file này thành .env và điều chỉnh giá trị

# API Configuration
API_BASE_URL=http://your-api.com
API_TIMEOUT=30

# Firebase (hiện tại không dùng, để dự phòng)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_API_KEY=your-api-key

# App Settings
APP_VERSION=1.0.0
DEBUG_MODE=true
USE_MOCK_DATA=true

# Test Account (hiện tại là mock)
TEST_EMAIL=user@test.com
TEST_PASSWORD=123456
