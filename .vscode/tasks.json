{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Flutter: Get Dependencies",
            "type": "shell",
            "command": "flutter",
            "args": [
                "pub",
                "get"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Flutter: Analyze",
            "type": "shell",
            "command": "flutter",
            "args": [
                "analyze"
            ],
            "group": "build",
            "problemMatcher": [
                "$dart"
            ]
        },
        {
            "label": "Flutter: Format Code",
            "type": "shell",
            "command": "dart",
            "args": [
                "format",
                "."
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Flutter: Run (Debug)",
            "type": "shell",
            "command": "flutter",
            "args": [
                "run",
                "-v"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Flutter: Run (Release)",
            "type": "shell",
            "command": "flutter",
            "args": [
                "run",
                "--release"
            ],
            "group": "test",
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Flutter: Run on Web",
            "type": "shell",
            "command": "flutter",
            "args": [
                "run",
                "-d",
                "chrome"
            ],
            "group": "test",
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Flutter: Clean Build",
            "type": "shell",
            "command": "flutter",
            "args": [
                "clean"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Flutter: Build APK",
            "type": "shell",
            "command": "flutter",
            "args": [
                "build",
                "apk",
                "--release"
            ],
            "group": "build",
            "problemMatcher": [
                "$dart"
            ]
        },
        {
            "label": "Flutter: List Devices",
            "type": "shell",
            "command": "flutter",
            "args": [
                "devices"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Flutter: Doctor",
            "type": "shell",
            "command": "flutter",
            "args": [
                "doctor",
                "-v"
            ],
            "group": "build",
            "problemMatcher": []
        }
    ]
}
